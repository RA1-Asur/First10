<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for First 10 operations -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesCondition" />

    <!-- Package visibility declarations for Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name=".First10Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.First10">

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop" />

        <!-- Launcher Alias for Stealth Friction Mode -->
        <activity-alias
            android:name=".MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Fullscreen Blocking Screen -->
        <activity
            android:name=".BlockingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="false"
            android:showWhenLocked="true"
            android:theme="@style/Theme.First10.Blocking"
            android:turnScreenOn="true" />

        <!-- Protected Settings Hub -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".MainActivity" />

        <!-- App Manager (Restricted / Allowed) -->
        <activity
            android:name=".AppManagerActivity"
            android:exported="false"
            android:label="@string/title_restricted_apps"
            android:parentActivityName=".SettingsActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Exclusion Scheduler -->
        <activity
            android:name=".ExclusionSchedulerActivity"
            android:exported="false"
            android:label="@string/title_exclusions"
            android:parentActivityName=".SettingsActivity" />

        <!-- Morning Routine Manager -->
        <activity
            android:name=".RoutineManagerActivity"
            android:exported="false"
            android:label="@string/title_routines"
            android:parentActivityName=".SettingsActivity" />

        <!-- Task Editor -->
        <activity
            android:name=".TaskEditorActivity"
            android:exported="false"
            android:label="@string/title_task_editor"
            android:parentActivityName=".RoutineManagerActivity" />

        <!-- Motivational Messages Manager -->
        <activity
            android:name=".MessagesActivity"
            android:exported="false"
            android:label="@string/title_messages"
            android:parentActivityName=".SettingsActivity" />

        <!-- Permissions & Health Overview -->
        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:label="@string/title_permissions"
            android:parentActivityName=".MainActivity" />

        <!-- PIN Entry & Setup -->
        <activity
            android:name=".PinActivity"
            android:exported="false"
            android:label="@string/title_pin"
            android:launchMode="singleTop" />

        <!-- PIN Recovery -->
        <activity
            android:name=".PinRecoveryActivity"
            android:exported="false"
            android:label="@string/title_pin_recovery" />

        <!-- Stealth Friction Mode Settings -->
        <activity
            android:name=".StealthActivity"
            android:exported="false"
            android:label="@string/title_stealth"
            android:parentActivityName=".SettingsActivity" />

        <!-- Emergency Access Hold-to-Bypass -->
        <activity
            android:name=".EmergencyAccessActivity"
            android:exported="false"
            android:label="@string/title_emergency" />

        <!-- MIUI 12.5 Setup Guide -->
        <activity
            android:name=".MiuiGuideActivity"
            android:exported="false"
            android:label="@string/title_miui_guide"
            android:parentActivityName=".PermissionsActivity" />

        <!-- Device Administrator Receiver -->
        <receiver
            android:name=".First10DeviceAdminReceiver"
            android:description="@string/perm_admin_desc"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- Unlock Detection Receiver (ACTION_USER_PRESENT) -->
        <receiver
            android:name=".UnlockReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- Reboot Recovery Receiver -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Dialer Secret Code Recovery (*#*#1010#*#*) -->
        <receiver
            android:name=".DialerCodeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data
                    android:host="1010"
                    android:scheme="android_secret_code" />
            </intent-filter>
        </receiver>

        <!-- Foreground Monitoring Service -->
        <service
            android:name=".First10MonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus and morning routine behavioral protection" />
        </service>

        <!-- Optional Accessibility Service for Zero-Latency Window Detection -->
        <service
            android:name=".First10AccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
