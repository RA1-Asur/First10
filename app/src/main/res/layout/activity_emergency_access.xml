<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="36dp"
    android:paddingEnd="24dp"
    android:paddingBottom="36dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMERGENCY ACCESS"
        android:textColor="@color/error"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="If you have an urgent real-world situation and need to access restricted apps immediately, you can trigger this emergency bypass."
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Hold to Bypass Button & Progress -->
    <TextView
        android:id="@+id/tvHoldInstructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Press and HOLD the button below for 10 seconds"
        android:textColor="@color/accent_gold"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressCircularHold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="0"
        app:indicatorColor="@color/error"
        app:indicatorSize="120dp"
        app:trackColor="@color/surface_variant"
        app:trackThickness="8dp" />

    <TextView
        android:id="@+id/tvHoldSeconds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="0 / 10s"
        android:textColor="@color/on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHoldEmergency"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:text="HOLD FOR 10 SECONDS"
        android:textColor="@color/on_error"
        app:backgroundTint="@color/error"
        app:cornerRadius="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelEmergency"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel &amp; Return"
        android:textColor="@color/text_muted" />

</LinearLayout>
