<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="48dp"
    android:paddingEnd="32dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/ivPinLock"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Security Lock"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/enter_pin"
        android:textColor="@color/on_background"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Enter your PIN to access protected settings"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- 4 PIN Dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_circle" />

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_circle" />

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_circle" />

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_circle" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/error"
        android:textSize="13sp"
        android:visibility="invisible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:id="@+id/gridKeypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Row 1: 1, 2, 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey1"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="1"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey2"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="2"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey3"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="3"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <!-- Row 2: 4, 5, 6 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey4"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="4"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey5"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="5"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey6"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="6"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <!-- Row 3: 7, 8, 9 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey7"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="7"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey8"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="8"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey9"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="9"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <!-- Row 4: Empty/Forgot, 0, Backspace -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForgotPin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="?"
            android:textColor="@color/text_muted"
            android:textSize="18sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey0"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="0"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:text="⌫"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

    </GridLayout>

</LinearLayout>
